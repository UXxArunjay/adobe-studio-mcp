<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.adobestudiomcp.hub" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Adobe Studio MCP Hub"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.adobestudiomcp.hub.bg" Version="1.0.0" />
    <Extension Id="com.adobestudiomcp.hub.panel" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]" />
      <Host Name="PPRO" Version="[14.0,99.9]" />
      <Host Name="PHXS" Version="[21.0,99.9]" />
      <Host Name="PHSP" Version="[21.0,99.9]" />
      <Host Name="ILST" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- invisible background bridge: starts automatically with the app -->
    <Extension Id="com.adobestudiomcp.hub.bg">
      <DispatchInfo>
        <Resources>
          <MainPath>./bg.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
          </StartOn>
        </Lifecycle>
        <UI><Type>Custom</Type><Geometry><Size><Height>1</Height><Width>1</Width></Size></Geometry></UI>
      </DispatchInfo>
    </Extension>
    <!-- visible panel: Window > Extensions > Adobe Studio MCP Hub (status + manual fallback) -->
    <Extension Id="com.adobestudiomcp.hub.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel.html</MainPath>
          <CEFCommandLine><Parameter>--enable-nodejs</Parameter><Parameter>--mixed-context</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Adobe Studio MCP Hub</Menu>
          <Geometry><Size><Height>220</Height><Width>320</Width></Size><MinSize><Height>120</Height><Width>220</Width></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
